{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv_tools\\Scripts\\python.exe",
  "terminal.integrated.defaultProfile.windows": "PowerShell (venv)",
  "terminal.integrated.profiles.windows": {
    "PowerShell (venv)": {
      "path": "powershell.exe",
      "args": [
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& '${workspaceFolder}\\.venv_tools\\Scripts\\Activate.ps1'"
      ]
    }
  }
}
