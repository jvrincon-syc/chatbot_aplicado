# Copy to secrets.env (git-ignored) and fill with REAL values locally. Never commit secrets.env.
# Two conventions coexist on purpose, pointing at the SAME instances:
#   * The .NET API reads the "Section__Key" vars (ConnectionStrings__*, RagTarget__*, Llm__*).
#   * The plain UPPER_CASE / *_URL vars are for dev tooling (.venv_tools, psql, redis-cli).

# ── PostgreSQL — the RAG lives HERE (pgvector + FTS), consumed READ-ONLY ───────
# Single database (sst_estable). The chatbot only reads it; it must not mutate RAG data.
# In prod use a runtime identity with SELECT-only permissions; in local dev the postgres
# user is fine. Keep the two lines below in sync (same host/db/user/password).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sst_estable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/sst_estable
# Same connection, .NET form (this is what the API reads):
ConnectionStrings__Rag=Host=localhost;Port=5432;Database=sst_estable;Username=postgres;Password=CHANGE_ME;SSL Mode=Prefer;Include Error Detail=false

# ── Redis — FAQ cache (Postgres remains the source of truth) ──────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
ConnectionStrings__Redis=localhost:6379,ssl=false

# ── RAG target — trusted server-side identity of the consumed release ─────────
RagTarget__ProjectId=
RagTarget__RagVariantId=
RagTarget__RagReleaseId=

# ── Local LLM (llama-server) ─────────────────────────────────────────────────
# Absolute path to the GGUF — external infrastructure, not committed to this repo.
CHATBOT_LLM_MODEL_PATH=C:\Users\jvrincon\Documents\rag-models\qwen3-1.7b\Qwen_Qwen3-1.7B-IQ4_XS.gguf
Llm__BaseUrl=http://127.0.0.1:8001
