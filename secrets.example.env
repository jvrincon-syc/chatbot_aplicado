# Redis event stream
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>
REDIS_URL=redis://:<redis-password>@localhost:6379/0

# PostgreSQL is used by the external retrieval environment, not by this API.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sst_stable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<postgres-password>
DATABASE_URL=postgresql://postgres:<postgres-password>@localhost:5432/sst_estable
SST_POSTGRES_DSN=postgresql://postgres:<postgres-password>@localhost:5432/sst_estable

# Local llama.cpp model
CHATBOT_LLM_MODEL_PATH=C:\path\to\Qwen_Qwen3-1.7B-IQ4_XS.gguf

# Chatbot API and external dispatch service
ASPNETCORE_ENVIRONMENT=Development
ChatbotDispatch__BaseUrl=http://127.0.0.1:8765
# Bearer token opaco. Siempre montarlo como texto exacto, aunque parezca numerico.
# Ejemplo valido: abc123.xyz456 o 1234567890
ChatbotDispatch__BearerToken=<token-bearer-opaco>
ChatbotDispatch__ProjectId=proj_sst-general
ChatbotDispatch__RagVariantId=ragv_local-bge
ChatbotDispatch__SubmitPath=/api/chatbot/questions
ChatbotDispatch__ReleasesPathTemplate=/api/platform/projects/{project_id}/releases?page=1&page_size=100
Llm__BaseUrl=http://127.0.0.1:8001
Llm__Model=qwen3-1.7b
CHATBOT_LOCAL_API_BASE_URL=http://localhost:5254
