ASPNETCORE_ENVIRONMENT=Development
ChatbotDispatch__BaseUrl=http://127.0.0.1:8000
# Bearer token opaco. Siempre montarlo como texto exacto, aunque parezca numerico.
# Ejemplo valido: abc123.xyz456 o 1234567890
