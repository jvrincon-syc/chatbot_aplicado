{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Llm": {
    "Provider": "OpenAiCompatible",
    "BaseUrl": "http://127.0.0.1:8001",
    "Model": "qwen3-1.7b",
    "RequestTimeoutSeconds": 60,
    "MaxOutputTokens": 200,
    "Temperature": 0
  },
  "ChatbotDispatch": {
    "BaseUrl": "http://127.0.0.1:8765",
